<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard — Pointesting</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="/vendor/htmx/htmx.min.js" defer></script>
    <script src="/assets/dashboard.js" defer></script>
  </head>
  <body hx-boost="true">
    <div id="page-loading" class="page-loading" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      <span>Memuat dashboard…</span>
    </div>

    <main id="dashboard-content" class="container" hidden>
      <header class="page-header">
        <div>
          <p class="eyebrow">Pointesting</p>
          <h1>Test Dashboard</h1>
          <p class="muted">Jalankan test case, pantau browser secara live, lalu lihat artifact.</p>
        </div>
      </header>

      <% if (projects.length === 0) { %>
        <section class="empty-state">
          <h2>Belum ada project</h2>
          <p class="muted">Buat project dan test case melalui REST API terlebih dahulu.</p>
        </section>
      <% } %>

      <% projects.forEach((project) => { %>
        <section class="project-card">
          <div class="project-heading">
            <div>
              <h2><%= project.name %></h2>
              <% if (project.baseUrl) { %>
                <p class="muted"><%= project.baseUrl %></p>
              <% } %>
            </div>
            <span class="count"><%= project.testCases.length %> test case</span>
          </div>

          <% if (project.testCases.length === 0) { %>
            <p class="muted project-empty">Project ini belum memiliki test case.</p>
          <% } %>

          <% project.testCases.forEach((testCase) => { %>
            <article class="test-case" data-test-case-id="<%= testCase.id %>">
              <div class="test-case-row">
                <div>
                  <h3><%= testCase.title %></h3>
                  <p class="muted"><%= Array.isArray(testCase.steps) ? testCase.steps.length : 0 %> langkah</p>
                </div>
                <button class="run-button" type="button" data-test-case-id="<%= testCase.id %>">
                  <span class="button-label">Run</span>
                  <span class="spinner spinner-small" aria-hidden="true" hidden></span>
                </button>
              </div>

              <section class="run-panel" aria-live="polite" hidden>
                <div class="run-panel-header">
                  <strong>Live run</strong>
                  <span class="status-badge status-queued">queued</span>
                </div>
                <div class="run-content">
                  <div class="live-placeholder">Menunggu frame browser…</div>
                  <img class="live-frame" alt="Live browser view" hidden />
                </div>
                <ol class="step-events"></ol>
              </section>
            </article>
          <% }); %>
        </section>
      <% }); %>
    </main>
  </body>
</html>
