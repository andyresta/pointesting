<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard — Pointesting</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="/vendor/htmx/htmx.min.js" defer></script>
    <script src="/assets/dashboard.js" defer></script>
  </head>
  <body>
    <div id="page-loading" class="page-loading" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      <span>Memuat dashboard…</span>
    </div>

    <div id="dashboard-content" hidden>
      <header class="navbar">
        <div class="navbar-inner">
          <a class="navbar-brand" href="/dashboard">
            <span class="brand-mark" aria-hidden="true">P</span>
            <span class="brand-name">Pointesting</span>
          </a>

          <nav class="navbar-nav" aria-label="Navigasi utama">
            <a class="nav-link is-active" href="/dashboard">Dashboard</a>
            <span class="nav-link nav-link-disabled" title="Segera hadir (Fase 3)">Test Generation</span>
            <span class="nav-link nav-link-disabled" title="Segera hadir (Fase 4)">Self-Healing</span>
            <span class="nav-link nav-link-disabled" title="Segera hadir (Fase 5)">Fixture</span>
          </nav>

          <div class="navbar-search">
            <input
              id="dashboard-search"
              type="search"
              placeholder="Cari project atau test case…"
              aria-label="Cari project atau test case"
              autocomplete="off"
            />
          </div>

          <div class="navbar-user">
            <button
              id="user-menu-button"
              class="user-menu-button"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span class="user-avatar" id="user-avatar">··</span>
              <span class="user-name" id="user-name">…</span>
            </button>
            <div class="user-menu" id="user-menu" hidden>
              <button id="logout-button" class="user-menu-item" type="button">
                <span class="button-label">Logout</span>
                <span class="spinner spinner-small" aria-hidden="true" hidden></span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main class="container">
        <div class="page-toolbar">
          <div>
            <h1 class="page-title">Project &amp; Test Case</h1>
            <p class="muted">Kelola project dan test case, jalankan browser, lalu lihat artifact serta analisis AI.</p>
          </div>
          <button id="new-project-button" type="button">Buat Project</button>
        </div>

        <p id="search-empty-state" class="search-empty-state muted" hidden>
          Tidak ada project atau test case yang cocok dengan pencarian.
        </p>

        <% if (projects.length === 0) { %>
          <section class="empty-state">
            <h2>Belum ada project</h2>
            <p class="muted">Klik “Buat Project”, simpan Instruction, lalu Generate Test Script.</p>
          </section>
        <% } %>

        <div class="project-list">
        <% projects.forEach((project) => { %>
          <section
            class="project-card"
            data-project-id="<%= project.id %>"
              data-project="<%= JSON.stringify({
              id: project.id,
              name: project.name,
              baseUrl: project.baseUrl,
              defaultProvider: project.defaultProvider,
              instruction: project.instruction,
              extraData: project.extraData,
              providers: project.providers
            }) %>"
          >
          <div class="project-heading">
            <div>
              <h2><%= project.name %></h2>
              <% if (project.baseUrl) { %>
                <p class="muted"><%= project.baseUrl %></p>
              <% } %>
              <p class="muted project-provider">
                Provider:
                <%=
                  project.defaultProvider === 'opencode' ? 'OpenCode Zen'
                  : project.defaultProvider === 'opencode-go' ? 'OpenCode Go'
                  : project.defaultProvider === 'openai' ? 'OpenAI'
                  : project.defaultProvider === 'deepseek' ? 'DeepSeek'
                  : project.defaultProvider === 'kimi' ? 'Kimi'
                  : 'Claude'
                %>
              </p>
            </div>
            <div class="project-actions">
              <span class="count"><%= project.testCases.length %> test case</span>
              <button
                class="icon-button edit-project-button"
                type="button"
                aria-label="Edit project"
                title="Edit project"
              >
                <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                </svg>
              </button>
              <button
                class="icon-button danger-button delete-project-button"
                type="button"
                aria-label="Hapus project"
                title="Hapus project"
                data-project-id="<%= project.id %>"
                data-project-name="<%= project.name %>"
              >
                <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 6h18" />
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                  <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                </svg>
                <span class="spinner spinner-small spinner-inline" aria-hidden="true" hidden></span>
              </button>
              <button
                class="secondary-button instruction-button"
                type="button"
                data-project-id="<%= project.id %>"
              >Instruction</button>
              <a
                class="generate-script-button"
                href="/dashboard/projects/<%= project.id %>/generate"
                data-project-id="<%= project.id %>"
              >
                <span class="button-label">Generate Test Script</span>
                <span class="spinner spinner-small" aria-hidden="true" hidden></span>
              </a>
            </div>
          </div>

          <% if (project.testCases.length === 0) { %>
            <p class="muted project-empty">Belum ada test case. Simpan Instruction, lalu klik Generate Test Script, atau buat manual dari dialog Instruction.</p>
          <% } %>

          <% project.testCases.forEach((testCase) => { %>
            <article
              class="test-case"
              data-test-case-id="<%= testCase.id %>"
              data-project-id="<%= project.id %>"
              data-test-case="<%= JSON.stringify({
                id: testCase.id,
                title: testCase.title,
                description: testCase.description,
                steps: testCase.steps,
                expected: testCase.expected
              }) %>"
            >
              <div class="test-case-row">
                <div>
                  <h3><%= testCase.title %></h3>
                  <% if (testCase.description) { %>
                    <p class="test-case-description"><%= testCase.description %></p>
                  <% } %>
                  <p class="muted"><%= Array.isArray(testCase.steps) ? testCase.steps.length : 0 %> langkah</p>
                  <div class="latest-analysis-summary" <%= testCase.latestAnalysisResult ? '' : 'hidden' %>>
                    <% if (testCase.latestAnalysisResult) { %>
                      <span
                        class="analysis-badge analysis-status-<%= testCase.latestAnalysisResult.status %>"
                        data-latest-analysis-badge
                      ><%= testCase.latestAnalysisResult.status %></span>
                      <span class="latest-analysis-label">
                        Analisis terakhir · <%= testCase.latestAnalysisResult.provider %>
                      </span>
                    <% } %>
                  </div>
                </div>
                <div class="test-case-actions">
                  <button class="secondary-button edit-test-case-button" type="button">Edit</button>
                  <button class="run-button" type="button" data-test-case-id="<%= testCase.id %>">
                    <span class="button-label">Run</span>
                    <span class="spinner spinner-small" aria-hidden="true" hidden></span>
                  </button>
                </div>
              </div>

              <section class="run-panel" aria-live="polite" hidden>
                <div class="run-panel-header">
                  <strong>Live run</strong>
                  <span class="status-badge status-queued">queued</span>
                </div>
                <div class="evidence-layout">
                  <div class="run-content">
                    <div class="live-placeholder">Menunggu frame browser…</div>
                    <img class="live-frame" alt="Live browser view" hidden />
                  </div>
                  <aside class="analysis-panel" aria-live="polite" hidden></aside>
                </div>
                <ol class="step-events"></ol>
              </section>
            </article>
          <% }); %>
          </section>
        <% }); %>
        </div>
      </main>
    </div>

    <dialog id="project-dialog" class="app-dialog">
      <form id="project-form" class="dialog-form" hx-boost="false">
        <input name="projectId" type="hidden" />
        <div class="dialog-header">
          <div>
            <p class="eyebrow">Project</p>
            <h2 id="project-dialog-title">Buat Project</h2>
          </div>
          <button class="icon-button" type="button" data-close-dialog aria-label="Tutup">×</button>
        </div>
        <label>
          Nama project
          <input name="name" required maxlength="120" autocomplete="off" />
        </label>
        <label>
          Base URL aplikasi (wajib untuk Instruction / generate AI)
          <input
            name="baseUrl"
            type="url"
            placeholder="https://example.com"
            autocomplete="url"
          />
        </label>
        <div class="form-section">
          <div class="form-section-heading">
            <div>
              <h3>API key provider</h3>
              <p id="provider-model-hint" class="field-hint">
                Centang Default pada satu baris. Urutan baris = urutan fallback.
              </p>
            </div>
            <button id="add-provider-key-button" class="secondary-button" type="button">
              Tambah cadangan
            </button>
          </div>
          <div id="provider-key-list" class="provider-key-list"></div>
        </div>
        <p class="alert form-error" hidden></p>
        <div class="dialog-actions">
          <button class="secondary-button" type="button" data-close-dialog>Batal</button>
          <button class="submit-button" type="submit">
            <span class="button-label">Simpan Project</span>
            <span class="spinner spinner-small" aria-hidden="true" hidden></span>
          </button>
        </div>
      </form>
    </dialog>

    <dialog id="instruction-dialog" class="app-dialog">
      <form id="instruction-form" class="dialog-form" hx-boost="false">
        <input name="projectId" type="hidden" />
        <div class="dialog-header">
          <div>
            <p class="eyebrow">Test Case</p>
            <h2 id="instruction-dialog-title">Instruction</h2>
          </div>
          <button class="icon-button" type="button" data-close-dialog aria-label="Tutup">×</button>
        </div>
        <p class="field-hint">
          Simpan instruction di project ini. Generate Test Script ada di kartu project: AI membuka Base URL, mengisi form sesuai instruction, lalu menyusun test case.
        </p>
        <label>
          Instruction
          <textarea
            name="prompt"
            required
            rows="6"
            maxlength="8000"
            placeholder="Contoh: Uji login dengan kredensial valid, lalu pastikan dashboard tampil."
          ></textarea>
        </label>
        <label>
          Data tambahan (opsional)
          <textarea
            name="extraData"
            rows="4"
            maxlength="8000"
            placeholder="Selector, dummy credential, catatan flow, cuplikan dokumen…"
          ></textarea>
        </label>
        <p class="alert form-error" hidden></p>
        <div class="dialog-actions">
          <button class="secondary-button" type="button" data-close-dialog>Batal</button>
          <button id="manual-test-case-button" class="secondary-button" type="button">
            Buat manual
          </button>
          <button class="submit-button" type="submit">
            <span class="button-label">Simpan Instruction</span>
            <span class="spinner spinner-small" aria-hidden="true" hidden></span>
          </button>
        </div>
      </form>
    </dialog>

    <dialog id="test-case-dialog" class="app-dialog app-dialog-wide">
      <form id="test-case-form" class="dialog-form" hx-boost="false">
        <input name="projectId" type="hidden" />
        <input name="testCaseId" type="hidden" />
        <div class="dialog-header">
          <div>
            <p class="eyebrow">Test Case</p>
            <h2 id="test-case-dialog-title">Tambah Test Case</h2>
          </div>
          <button class="icon-button" type="button" data-close-dialog aria-label="Tutup">×</button>
        </div>
        <label>
          Judul test case
          <input name="title" required maxlength="160" autocomplete="off" />
        </label>
        <label>
          Keterangan
          <textarea
            name="description"
            rows="3"
            maxlength="2000"
            placeholder="Ringkas tujuan uji, misalnya: memastikan login valid membuka dashboard."
          ></textarea>
        </label>
        <div class="form-section">
          <div class="form-section-heading">
            <div>
              <h3>Langkah pengujian</h3>
              <p class="field-hint">Langkah dijalankan berurutan dari atas ke bawah.</p>
            </div>
            <button id="add-step-button" class="secondary-button" type="button">Tambah Step</button>
          </div>
          <div id="step-list" class="step-builder"></div>
        </div>
        <label>
          Expected result
          <textarea
            name="expected"
            required
            rows="4"
            placeholder="Satu expected result per baris"
          ></textarea>
        </label>
        <p class="alert form-error" hidden></p>
        <div class="dialog-actions">
          <button class="secondary-button" type="button" data-close-dialog>Batal</button>
          <button class="submit-button" type="submit">
            <span class="button-label">Simpan Test Case</span>
            <span class="spinner spinner-small" aria-hidden="true" hidden></span>
          </button>
        </div>
      </form>
    </dialog>
  </body>
</html>
