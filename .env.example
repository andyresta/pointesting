# Koneksi PostgreSQL
DB_HOST=localhost
DB_NAME=pointesting
DB_PORT=5432
DB_USER=postgres
DB_PASS=

# Port HTTP server (Fastify)
PORT=3000

# Secret untuk sign JWT
AUTH_SECRET=change-me

# Kredensial personal/single-user (tanpa tabel user di database)
# Generate hash password dengan: npm run hash-password -- "password-anda"
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# API key & pilihan model tiap provider LLM (semua opsional, isi salah satu
# atau lebih sesuai provider yang dipakai).
# *_MODEL   = model default yang aktif dipakai
# *_MODELS  = fallback CSV jika katalog dinamis provider sedang tidak tersedia.
# Pilihan utama UI diambil backend dari endpoint model resmi provider via
# POST /ai/models; API key tidak pernah dikirim ke browser.
CLAUDE_API_KEY=
CLAUDE_MODEL=
CLAUDE_MODELS=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_MODELS=

OPENCODE_API_KEY=
# OpenCode di aplikasi ini berarti OpenCode Zen (https://opencode.ai/zen/v1).
OPENCODE_MODEL=claude-sonnet-4-5
OPENCODE_MODELS=claude-sonnet-4-5,gpt-5,deepseek-v4-flash-free

# Concurrency in-memory queue (p-queue). testRunQueue lebih kecil karena
# tiap job menjalankan instance browser Playwright (berat CPU/RAM).
TEST_RUN_QUEUE_CONCURRENCY=2
ANALYSIS_QUEUE_CONCURRENCY=3
